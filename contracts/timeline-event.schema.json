{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "程序时间线事件",
  "description": "有序退出服务的程序时间线由本结构的事件组成: 年报、经营迹象、联系记录、税务社保状态、债权申报、司法限制、公告、异议、回执、通知、清算证据、举报、程序转移与风险标记。案件状态与退出结论均可由事件序列重建。",
  "type": "object",
  "required": ["id", "seq", "caseId", "category", "at"],
  "properties": {
    "id": { "type": "string", "description": "事件编号, 案件内唯一" },
    "seq": { "type": "integer", "minimum": 1, "description": "案件内事件序号" },
    "caseId": { "type": "string", "description": "案件编号" },
    "category": {
      "type": "string",
      "enum": [
        "annualReport",
        "businessSign",
        "contact",
        "taxSocial",
        "judicialRestriction",
        "claim",
        "objection",
        "announcement",
        "receipt",
        "notice",
        "liquidation",
        "report",
        "transition",
        "riskFlag"
      ],
      "description": "事件类别: 年报/经营迹象/联系记录/税务社保/司法限制/债权申报/异议/公告/回执/通知/清算证据/举报/转移/风险标记"
    },
    "at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "事件日期(YYYY-MM-DD)"
    },
    "action": {
      "type": "string",
      "description": "类别内动作, 如 declare/withdraw(债权)、file/rule(异议)、start/pause/resume/archive(公告)"
    },
    "sensitive": {
      "type": "boolean",
      "description": "举报事件专用: 敏感举报仅经办角色可见, 缺省视为敏感"
    }
  },
  "additionalProperties": true
}
